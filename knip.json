{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/routes/**/*.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "react-scan",
        "tailwindcss"
      ],
      "tailwind": false
    }
  },
  "ignore": [
