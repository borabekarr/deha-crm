{
  "name": "@deha/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test:lite": "bash ../../scripts/test-lite.sh",
    "test:motion-cascade": "playwright test motion-cascade --project=default",
    "check-bundle-budget": "MODE_BUDGET=1 vite build && node ./scripts/check-bundle-budget.mjs",
    "test:eslint-rules": "node --test eslint-rules/*.test.js"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/router-devtools": "^1.167.1",
    "d3-shape": "^3.2.0",
    "framer-motion": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "react-scan": "^0.5.7",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
